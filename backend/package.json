{
  "name": "sensecheck-ai-backend",
  "version": "1.0.0",
  "description": "SenseCheck AI Backend — OCR, QR decode, scam scoring, Cloudinary, PostgreSQL",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon server.js",
    "worker": "nodemon worker.js",
    "start": "node server.js",
    "db:migrate": "npx prisma migrate dev",
    "db:push": "npx prisma db push",
    "db:studio": "npx prisma studio",
    "db:seed": "node prisma/seed.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "@sentry/node": "^10.74.0",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.12.0",
    "cloudinary": "^2.3.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^7.3.1",
    "file-type": "^22.0.2",
    "form-data": "^4.0.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jimp": "^1.6.1",
    "jsonwebtoken": "^9.0.2",
    "jsqr": "^1.4.0",
    "multer": "^2.0.0",
    "node-fetch": "^2.7.0",
    "nodemailer": "^10.0.1",
    "openai": "^4.52.7",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "pino-pretty": "^11.2.2",
    "sharp": "^0.35.4",
    "tesseract.js": "^5.1.0",
    "uuid": "^11.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "prisma": "^5.14.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ]
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "prisma@5.22.0": true,
    "sharp@0.33.5": true,
    "tesseract.js@5.1.1": true,
    "@prisma/engines@5.22.0": true,
    "msgpackr-extract@3.0.4": true
  }
}

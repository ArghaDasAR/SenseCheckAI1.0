# ─────────────────────────────────────────────
# SenseCheck AI Backend — Environment Variables
# Copy this file to .env and fill in your keys
# ─────────────────────────────────────────────

# Server
PORT=4000
NODE_ENV=development

# JWT — access token (short-lived) + refresh token (long-lived)
# Generate secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password Reset
PASSWORD_RESET_EXPIRES_MINUTES=30

# ─── Database (PostgreSQL) ───────────────────
# Free options: https://neon.tech  |  https://supabase.com
DATABASE_URL=postgresql://user:password@localhost:5432/sensecheck-ai

# ─── Redis ───────────────────────────────────
# Local: docker run -p 6379:6379 redis:alpine
# Cloud: https://upstash.com (free tier)
REDIS_URL=redis://localhost:6379

# ─── Cloudinary ──────────────────────────────
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── OpenAI (LLM Scam Classifier) ────────────
# Model: gpt-4o-mini (fast + cheap ~$0.00015/scan)
OPENAI_API_KEY=sk-...

# ─── Google Cloud Vision (OCR) ───────────────
# Leave blank → Tesseract.js local fallback (slower but free)
GOOGLE_VISION_API_KEY=

# ─── VirusTotal (URL Reputation) ─────────────
# Free: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=

# ─── Google Safe Browsing ────────────────────
GOOGLE_SAFE_BROWSING_API_KEY=

# ─── Sentry (Error Tracking) ─────────────────
# Free tier: https://sentry.io
# Leave blank to disable
SENTRY_DSN=

# ─── Email / SMTP (Password Reset) ───────────
# Dev: use https://mailtrap.io for testing
EMAIL_FROM=noreply@sensecheck.ai
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── Frontend ────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Rate Limiting ───────────────────────────
RATE_LIMIT_WINDOW_MS=900000
UPLOAD_RATE_LIMIT_MAX=20
SCAN_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_MAX=10
REPORT_RATE_LIMIT_MAX=5

# Cloudinary Configuration
# Obtain these from your Cloudinary dashboard: https://cloudinary.com/console

# Your Cloudinary cloud name (safe to expose on frontend)
VITE_CLOUDINARY_CLOUD_NAME=

# An UNSIGNED upload preset (safe to expose on frontend)
# Create one in: Cloudinary Console → Settings → Upload → Upload presets → Add preset → Signing mode: Unsigned
VITE_CLOUDINARY_UPLOAD_PRESET=

# NEVER put the following in this file or any frontend code:
# CLOUDINARY_API_SECRET    ← server-side only
# CLOUDINARY_API_KEY       ← server-side only
